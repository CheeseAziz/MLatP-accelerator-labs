# Optional. Without a key the assistant runs on the built-in Rivertree knowledge base.
ANTHROPIC_API_KEY=

# Optional. Without SMTP settings, "Send" runs in demo mode (logged to the Sent folder only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rivertree Insurance <service@example.com>"
